# ---------------------------------------------------------------------------
# AGENT-READINESS AUDITOR - environment configuration
# Copy this file to .env and adjust values.
# The shipped .env already contains safe Windows-local defaults (SQLite + inline).
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) ------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
APP_ENV=development                 # development | testing | production
DEBUG=true
SECRET_KEY=dev-secret-change-me     # used for signed API tokens / CSRF

# --- Database ----------------------------------------------------------------
# Default local Windows development (no install, runs immediately):
DATABASE_URL=sqlite+aiosqlite:///./data/auditor.db
# Recommended: PostgreSQL running on the same machine. First provision it:
#   psql -U postgres -c "CREATE ROLE auditor LOGIN PASSWORD 'auditor' CREATEDB;"
#   psql -U postgres -c "CREATE DATABASE auditor OWNER auditor;"
# DATABASE_URL=postgresql+psycopg://auditor:auditor@localhost:5432/auditor
# Docker Compose (the backend/worker services override DATABASE_URL/REDIS_URL):
# DATABASE_URL=postgresql+psycopg://auditor:auditor@postgres:5432/auditor

# --- Redis / Job queue ------------------------------------------------------
# inline = run audit jobs in-process (dev, no Redis required)
# celery = dispatch to Celery workers (Docker/production)
REDIS_URL=redis://localhost:6379/0
JOB_MODE=inline
# When JOB_MODE=celery, set CELERY_BROKER_URL (defaults to REDIS_URL).

# --- Crawler limits ---------------------------------------------------------
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_SECONDS=15
CRAWL_RATE_LIMIT_SECONDS=0.2
CRAWL_MAX_RESPONSE_BYTES=5242880     # 5 MB per response
CRAWL_CONCURRENCY=4
MAX_URLS_PER_SITEMAP=500

# --- SSRF protection --------------------------------------------------------
ALLOW_PRIVATE_IP_RANGES=false        # must stay false in production
# To audit a site you serve locally, add its hostname here, e.g.:
# BLOCKED_HOSTNAMES=127.0.0.1
BLOCKED_HOSTNAMES=localhost,127.0.0.1,[::1],0.0.0.0

# --- AI (optional). AI analysis is additive; audit works without it. --------
AI_PROVIDER=none                     # none | openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend ---------------------------------------------------------------
# API base URL for the frontend (must include the /api suffix). Use
# http://localhost:8000/api when frontend and backend run on the same machine.
# When the app is opened via a LAN IP (e.g. http://192.168.160.1:3000), set it
# to that machine's LAN IP (backend must then listen on 0.0.0.0):
#   NEXT_PUBLIC_API_BASE_URL=http://192.168.160.1:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- CORS -------------------------------------------------------------------
# Extra browser origins allowed to call the API (comma-separated). Standard
# localhost origins and the origin derived from FRONTEND_URL are always allowed.
# Add the exact origin(s) the frontend is opened from when it is NOT localhost,
# e.g. http://192.168.160.1:3000. Never use "*".
CORS_ORIGINS=http://192.168.160.1:3000

# --- Email (password reset) -------------------------------------------------
# Public URL used to build reset links in emails. Must be reachable by the
# person clicking the link (use the LAN IP / domain the app is served on).
FRONTEND_URL=http://localhost:3000
# SMTP provider (Gmail example). Fill SMTP_USER + SMTP_PASSWORD (App Password).
# While blank, the backend logs "SMTP is not configured" and does NOT pretend
# the email was sent. Never commit real values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
