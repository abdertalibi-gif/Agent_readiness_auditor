# ---------------------------------------------------------------------------
# Frontend (Next.js) local environment - copy to .env.local and adjust.
# NEXT_PUBLIC_* variables are inlined at build time by Next.js.
# ---------------------------------------------------------------------------
# API base URL (must include the /api suffix). Use http://localhost:8000/api
# when frontend and backend run on the same machine and the browser uses
# http://localhost:3000. When the app is opened via the LAN IP
# (e.g. http://192.168.160.1:3000), point this at the machine's LAN IP and make
# sure the backend listens on 0.0.0.0:8000:
#   NEXT_PUBLIC_API_BASE_URL=http://192.168.160.1:8000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_MONETIZATION_ENABLED=false
