FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# System deps for lxml (crawler) + psycopg (postgres)
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libxml2-dev libxslt1-dev libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Repository root is the Docker build context (render.yaml: dockerContext: .)
# Copy only required directories
COPY backend/pyproject.toml backend/
COPY backend/ backend/
COPY worker/ worker/

RUN pip install --upgrade pip \
    && pip install -e backend/

WORKDIR /app/backend

EXPOSE 8000

# Render injects $PORT; alembic migrates external DB (Neon) on startup
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
